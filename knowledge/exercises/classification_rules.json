{
  "schema_version": "1.0.0",
  "rules_version": "1.0.0",
  "notes": "Reglas ordenadas: gana la primera que coincide. name_regex es case-insensitive sobre el nombre crudo. target_in restringe por target del dataset. Si otras reglas con distinto patrón también coinciden, se registran en also_matched y la confianza 'high' baja a 'medium'.",
  "movement_pattern_rules": [
    { "id": "mp.stretch", "name_regex": "stretch", "value": "other", "confidence": "high", "exercise_type": "mobility" },
    { "id": "mp.mobility_drills", "name_regex": "\\bcircles?\\b|circular|foam roll|massage|mobility|arm slingers|arm swings?|\\bpose\\b|sphinx|upward facing dog|pelvic tilt", "value": "other", "confidence": "medium", "exercise_type": "mobility" },
    { "id": "mp.carry", "name_regex": "farmer|\\bcarry\\b|suitcase walk|waiter walk", "value": "carry", "confidence": "high" },
    { "id": "mp.straight_arm_pulldown", "name_regex": "straight[- ]arm pull\\s?-?down|pullover", "value": "vertical_pull", "confidence": "medium", "exercise_type": "isolation" },
    { "id": "mp.vertical_pull", "name_regex": "pull-?\\s?ups?\\b|chin-?\\s?ups?\\b|pull\\s?-?downs?|muscle-?\\s?ups?\\b|rope climb", "value": "vertical_pull", "confidence": "high" },
    { "id": "mp.chin_variants", "name_regex": "\\bchin\\b", "target_in": ["lats"], "value": "vertical_pull", "confidence": "medium" },
    { "id": "mp.upright_row", "name_regex": "upright row", "value": "shoulder_abduction", "confidence": "medium", "exercise_type": "compound" },
    { "id": "mp.rear_delt", "name_regex": "rear delt|deltoid rear|revers?e? fly|reverse flye|rear lateral raise|rear fly", "value": "horizontal_pull", "confidence": "medium", "exercise_type": "isolation" },
    { "id": "mp.horizontal_pull", "name_regex": "\\brows?\\b|rowing|face pull", "value": "horizontal_pull", "confidence": "high" },
    { "id": "mp.vertical_push", "name_regex": "handstand push|pike push|shoulder press|military press|overhead press|push press|arnold press|landmine press|\\bjerk\\b", "value": "vertical_push", "confidence": "high" },
    { "id": "mp.jm_press", "name_regex": "\\bjm\\b", "value": "elbow_extension", "confidence": "medium", "exercise_type": "isolation" },
    { "id": "mp.chest_fly", "name_regex": "\\bfly\\b|\\bflyes?\\b|pec deck|crossover", "value": "horizontal_push", "confidence": "medium", "exercise_type": "isolation" },
    { "id": "mp.dips", "name_regex": "\\bdips?\\b", "value": "vertical_push", "confidence": "low", "exercise_type": "compound" },
    { "id": "mp.horizontal_push", "name_regex": "bench press|chest press|floor press|push-?\\s?ups?\\b|pin press|(incline|decline|lying).*press", "value": "horizontal_push", "confidence": "high" },
    { "id": "mp.delts_press", "name_regex": "press", "target_in": ["delts"], "value": "vertical_push", "confidence": "medium" },
    { "id": "mp.glute_kickback", "name_regex": "glute kickback|donkey kick|hip extension", "value": "hip_dominant", "confidence": "medium", "exercise_type": "isolation" },
    { "id": "mp.leg_extension", "name_regex": "leg extension", "value": "knee_dominant", "confidence": "high", "exercise_type": "isolation" },
    { "id": "mp.trunk_extension", "name_regex": "hyperextension|back extension|superman", "value": "trunk_extension", "confidence": "medium" },
    { "id": "mp.triceps_named", "name_regex": "tricep|push\\s?-?down|skull\\s?crusher|kickback|french press", "value": "elbow_extension", "confidence": "high" },
    { "id": "mp.triceps_extension", "name_regex": "extension", "target_in": ["triceps"], "value": "elbow_extension", "confidence": "high" },
    { "id": "mp.wrist", "name_regex": "wrist|finger curl|gripper|hand grip", "value": "wrist", "confidence": "medium" },
    { "id": "mp.knee_flexion", "name_regex": "leg curl|hamstring curl|nordic|glute[- ]ham", "value": "knee_flexion", "confidence": "high" },
    { "id": "mp.elbow_flexion", "name_regex": "^(?!.*(leg|hamstring|wrist|finger) curl).*\\bcurls?\\b", "value": "elbow_flexion", "confidence": "high" },
    { "id": "mp.knee_dominant", "name_regex": "squat|lunge|leg press|hack|step-?\\s?up|pistol|sissy|wall sit", "value": "knee_dominant", "confidence": "high" },
    { "id": "mp.olympic", "name_regex": "\\bclean\\b|snatch|thruster", "value": "other", "confidence": "medium", "exercise_type": "compound" },
    { "id": "mp.trunk_stabilization", "name_regex": "plank|pallof|dead bug|bird dog|roll\\s?-?out|rollerout|fallout|ab wheel|side bridge|hollow|l-sit|body saw", "value": "trunk_stabilization", "confidence": "high" },
    { "id": "mp.abs_hip_raise", "name_regex": "hip raise", "target_in": ["abs"], "value": "trunk_flexion", "confidence": "high" },
    { "id": "mp.hip_dominant", "name_regex": "deadlift|\\brdl\\b|hip thrust|\\bbridge\\b|good morning|\\bswing\\b|pull[- ]through|rack pull|reverse hyper|hip lift|hip raise", "value": "hip_dominant", "confidence": "high" },
    { "id": "mp.hip_abduction", "name_regex": "abduction|abductor|fire hydrant|clam\\s?shell|lateral band walk|monster walk|side lying leg raise|lateral leg raise", "value": "hip_abduction", "confidence": "high" },
    { "id": "mp.hip_adduction", "name_regex": "adduction|adductor|copenhagen", "value": "hip_adduction", "confidence": "high" },
    { "id": "mp.calf", "name_regex": "calf|calves|heel raise|toe raise", "value": "ankle_plantarflexion", "confidence": "high" },
    { "id": "mp.shoulder_abduction", "name_regex": "lateral raise|side raise|y-?\\s?raise|lu raise", "value": "shoulder_abduction", "confidence": "high" },
    { "id": "mp.shoulder_flexion", "name_regex": "front raise|front shoulder raise|forward raise", "value": "shoulder_flexion", "confidence": "high" },
    { "id": "mp.shrug", "name_regex": "shrug", "value": "scapular_elevation", "confidence": "high" },
    { "id": "mp.limb_rotation", "name_regex": "(internal|external) (shoulder |hip )?rotation|(shoulder|hip) (internal|external) rotation", "value": "other", "confidence": "medium", "exercise_type": "isolation" },
    { "id": "mp.trunk_rotation", "name_regex": "twist|russian|wood\\s?chop|rotation|rotational|windmill", "value": "trunk_rotation", "confidence": "medium" },
    { "id": "mp.side_bend", "name_regex": "side ben[dt]", "value": "trunk_flexion", "confidence": "low" },
    { "id": "mp.trunk_flexion", "name_regex": "crunch|sit-?\\s?ups?\\b|leg raise|knee raise|v-?\\s?ups?\\b|jackknife|toe touch|toes to bar|flutter kick|scissor|heel touch|elbow[- ]to[- ]knee|pull[- ]in\\b", "value": "trunk_flexion", "confidence": "high" },
    { "id": "mp.plyometric_conditioning", "name_regex": "jump|burpee|jacks?\\b|skater|\\bhops?\\b|bound|high knee|butt kick|mountain climber|battling rope|battle rope|\\bslam\\b", "value": "other", "confidence": "medium", "exercise_type": "conditioning" },
    { "id": "mp.cardio_machines", "name_regex": "bike|cycling|elliptical|ergometer|skierg", "value": "other", "confidence": "medium", "exercise_type": "conditioning" },
    { "id": "mp.locomotion", "name_regex": "\\brun\\b|running|jog|sprint|\\bwalk(ing)?\\b|stepmill|stair", "target_in": ["cardiovascular system", "quads", "calves", "glutes", "hamstrings"], "value": "locomotion", "confidence": "medium" }
  ],
  "movement_pattern_target_fallback": {
    "calves": { "value": "ankle_plantarflexion", "confidence": "medium" },
