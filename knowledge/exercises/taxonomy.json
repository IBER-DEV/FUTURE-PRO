  "decisions": [
    {
      "id": "tax.add_unknown",
      "change": "Se agregó 'unknown' a movement_pattern, exercise_type y mechanical_role.",
      "reason": "'other' significa 'clasificado, pero fuera de la taxonomía'; 'unknown' significa 'no se pudo clasificar'. Mezclarlos oculta qué ejercicios faltan por revisar."
    },
    {
      "id": "tax.add_knee_flexion",
      "change": "Se agregó movement_pattern 'knee_flexion' (curl femoral, nordic).",
      "reason": "El curl femoral flexiona la rodilla; clasificarlo como hip_dominant sería biomecánicamente incorrecto."
    },
    {
      "id": "tax.add_small_joint_patterns",
      "change": "Se agregaron 'ankle_plantarflexion', 'hip_abduction', 'hip_adduction', 'wrist' y 'scapular_elevation'.",
      "reason": "El dataset tiene grupos grandes (59 de 'lower legs', 37 de 'lower arms', encogimientos, máquinas de abductores) que de otro modo caerían en 'other' y no podrían seleccionarse por patrón."
    },
    {
      "id": "tax.add_trunk_stabilization",
      "change": "Se agregó 'trunk_stabilization' (planchas, pallof press, rollouts, dead bug).",
      "reason": "Son ejercicios anti-movimiento/isométricos; forzarlos a trunk_flexion o trunk_rotation describiría mal el estímulo."
    },
    {
      "id": "tax.fly_as_horizontal_push",
      "change": "Aperturas de pecho se clasifican como horizontal_push (isolation); aperturas invertidas/deltoide posterior como horizontal_pull (isolation).",
      "reason": "Mecánicamente son aducción/abducción horizontal, no un empuje/tracción. Se agrupan así por uso en programación (mismo plano y músculos), con confianza media para dejarlo visible."
    },
    {
      "id": "tax.equipment_access",
      "change": "Se reemplazó gym_compatible por equipment_access (none/minimal/gym/unknown); home_compatible se deriva de él.",
      "reason": "Cualquier ejercicio es compatible con un gimnasio, así que gym_compatible no aporta información. El nivel de acceso sí permite filtrar por lo que el usuario tiene."
    },
    {
      "id": "tax.no_subjective_inference",
      "change": "difficulty, technical_complexity, stability_demand y fatigue_cost no se infieren en v1 (quedan 'unknown' / not_assessed).",
      "reason": "El dataset no contiene señales para estas variables. Deducirlas del nombre o del equipo sería inventar precisión; se llenan solo mediante overrides revisados."
    },
    {
      "id": "tax.muscle_normalization_conservative",
      "change": "Solo se fusionan sinónimos claros (abs/abdominals, delts/deltoids, lats/latissimus dorsi, quads/quadriceps, traps/trapezius). Términos de región (back, core, shoulders...) se marcan con granularity 'region'.",
      "reason": "Fusionar región con músculo (p.ej. chest→pectorals) cambiaría el significado de la fuente."
    },
    {
      "id": "tax.primary_muscle_from_target",
      "change": "primary_muscles = target del dataset; se ignora muscle_group.",
      "reason": "En los 1.324 registros muscle_group es igual a secondary_muscles[0]; no representa el músculo principal. Se respeta el target de la fuente aunque sea discutible (p.ej. sentadilla → glutes)."
    }
  ]
}
